<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.estudos</groupId>
    <artifactId>spring-cloud-examples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>cl-lab-it</artifactId>
  <name>04 - Laboratorio (testes de integracao com subprocessos)</name>
  <dependencies>
    <dependency>
      <groupId>dev.estudos</groupId><artifactId>cl-config-server</artifactId><version>${project.version}</version>
      <scope>provided</scope>   <!-- so para ordenar o reator; os jars -exec rodam em subprocessos -->
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>dev.estudos</groupId><artifactId>cl-eureka-server</artifactId><version>${project.version}</version>
      <scope>provided</scope>   <!-- so para ordenar o reator; os jars -exec rodam em subprocessos -->
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>dev.estudos</groupId><artifactId>cl-catalog</artifactId><version>${project.version}</version>
      <scope>provided</scope>   <!-- so para ordenar o reator; os jars -exec rodam em subprocessos -->
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>dev.estudos</groupId><artifactId>cl-orders</artifactId><version>${project.version}</version>
      <scope>provided</scope>   <!-- so para ordenar o reator; os jars -exec rodam em subprocessos -->
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>dev.estudos</groupId><artifactId>cl-gateway</artifactId><version>${project.version}</version>
      <scope>provided</scope>   <!-- so para ordenar o reator; os jars -exec rodam em subprocessos -->
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>dev.estudos</groupId><artifactId>cl-gateway-mvc</artifactId><version>${project.version}</version>
      <scope>provided</scope>   <!-- so para ordenar o reator; os jars -exec rodam em subprocessos -->
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
      <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
    </plugin>
  </plugins></build>
</project>
